<UserControl x:Class="Pakban.Views.RamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Pakban.Localization"
             xmlns:c="clr-namespace:Pakban.Controls"
             xmlns:vm="clr-namespace:Pakban.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,22,30,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Style="{DynamicResource TitleText}"
                               Text="{Binding [ram_title], Source={x:Static l:Loc.I}}"/>
                    <TextBlock Style="{DynamicResource SubText}" Margin="0,4,0,0"
                               Text="{Binding [ram_sub], Source={x:Static l:Loc.I}}"/>
                </StackPanel>
                <Button Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        MinWidth="150" Command="{Binding OptimizeCommand}"
                        Content="{Binding [btn_optimize], Source={x:Static l:Loc.I}}"/>
            </Grid>

            <!-- Stat cards -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
                <Border Style="{DynamicResource Card}" l:Flow.End="14" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource DimText}"
                                   Text="{Binding [ram_total], Source={x:Static l:Loc.I}}"/>
                        <TextBlock Style="{DynamicResource StatText}" Margin="0,10,0,0"
                                   Text="{Binding TotalText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" l:Flow.End="14" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource DimText}"
                                   Text="{Binding [ram_used], Source={x:Static l:Loc.I}}"/>
                        <TextBlock Style="{DynamicResource StatText}" Margin="0,10,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding UsedText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" l:Flow.End="14" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource DimText}"
                                   Text="{Binding [ram_available], Source={x:Static l:Loc.I}}"/>
                        <TextBlock Style="{DynamicResource StatText}" Margin="0,10,0,0"
                                   Foreground="{DynamicResource OkBrush}"
                                   Text="{Binding AvailableText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource DimText}"
                                   Text="{Binding [ram_cached], Source={x:Static l:Loc.I}}"/>
                        <TextBlock Style="{DynamicResource StatText}" Margin="0,10,0,0"
                                   Text="{Binding CachedText}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Live chart + usage ring -->
            <Grid Grid.Row="2" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2.2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource Card}" l:Flow.End="14" Margin="0">
                    <Grid MinHeight="210">
                        <c:DonutChart Segments="{Binding UsageSegments}"/>
                        <StackPanel IsHitTestVisible="False"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CenterText}" FontSize="24" FontWeight="Bold"
                                       FlowDirection="LeftToRight"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource FgBrush}"/>
                            <TextBlock Text="{Binding CenterSubText}" FontSize="11.5" Margin="0,2,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Foreground="{DynamicResource FgDimBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{DynamicResource CardTitleText}" Margin="0,0,0,8"
                                   Text="{Binding [ram_history], Source={x:Static l:Loc.I}}"/>
                        <c:LineChart Grid.Row="1" MinHeight="150" Points="{Binding Points}"/>
                        <TextBlock Grid.Row="2" Style="{DynamicResource DimText}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="{Binding [ram_optimize_hint], Source={x:Static l:Loc.I}}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Top processes -->
            <Border Grid.Row="3" Style="{DynamicResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Style="{DynamicResource CardTitleText}"
                                   Text="{Binding [ram_top], Source={x:Static l:Loc.I}}"/>
                        <Button Style="{DynamicResource IconButton}" HorizontalAlignment="Right" Margin="0,-6,0,0"
                                Command="{Binding RefreshProcessesCommand}"
                                ToolTip="{Binding [ram_refresh], Source={x:Static l:Loc.I}}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TopProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5"
                                               Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <c:PercentBar Grid.Column="1" Height="6" Margin="14,0"
                                                  Fraction="{Binding Fraction}" BarBrush="{Binding Brush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold"
                                               Style="{StaticResource LtrText}"
                                               Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" MinWidth="72"
                                               TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

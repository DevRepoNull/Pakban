<UserControl x:Class="Pakban.Views.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Pakban.Localization"
             xmlns:c="clr-namespace:Pakban.Controls"
             xmlns:vm="clr-namespace:Pakban.ViewModels">

    <Grid Margin="30,22,30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Style="{DynamicResource TitleText}"
                           Text="{Binding [cleaner_title], Source={x:Static l:Loc.I}}"/>
                <TextBlock Style="{DynamicResource SubText}" Margin="0,4,0,0"
                           Text="{Binding [cleaner_sub], Source={x:Static l:Loc.I}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{DynamicResource GhostButton}" l:Flow.End="10" Margin="0"
                        Command="{Binding ScanCommand}"
                        Content="{Binding [btn_scan], Source={x:Static l:Loc.I}}"/>
                <Button Style="{DynamicResource PrimaryButton}" MinWidth="150"
                        Command="{Binding CleanCommand}"
                        Content="{Binding [btn_clean], Source={x:Static l:Loc.I}}"/>
            </StackPanel>
        </Grid>

        <!-- Tabs + selection helpers -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Border Background="{DynamicResource Bg2Brush}" CornerRadius="12" Padding="4"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabStandard" Style="{DynamicResource SegRadio}" GroupName="cleanerTabs"
                                 IsChecked="True" Checked="OnStandardTab"
                                 Content="{Binding [tab_standard], Source={x:Static l:Loc.I}}"/>
                    <RadioButton x:Name="TabOrphans" Style="{DynamicResource SegRadio}" GroupName="cleanerTabs"
                                 Checked="OnOrphansTab"
                                 Content="{Binding [tab_orphans], Source={x:Static l:Loc.I}}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{DynamicResource IconButton}" FontSize="11.5" Padding="10,6"
                        Command="{Binding SelectAllCommand}"
                        Content="{Binding [btn_select_all], Source={x:Static l:Loc.I}}"/>
                <Button Style="{DynamicResource IconButton}" FontSize="11.5" Padding="10,6"
                        Command="{Binding ClearSelectionCommand}"
                        Content="{Binding [btn_clear_sel], Source={x:Static l:Loc.I}}"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="2">
            <!-- Admin hint -->
            <Border Style="{DynamicResource Card}" Padding="14,10" MaxHeight="52" VerticalAlignment="Top"
                    Visibility="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static l:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource FgDimBrush}" l:Flow.Start="10" Margin="0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="{Binding [cleaner_admin_hint], Source={x:Static l:Loc.I}}"/>
                </StackPanel>
            </Border>

            <!-- Standard categories -->
            <ListBox x:Name="StandardList" Style="{DynamicResource QuietList}" Margin="0,62,0,0"
                     ItemsSource="{Binding Categories}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Style="{DynamicResource ModernCheck}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding Locked, Converter={x:Static l:InverseBoolConverter.Instance}}"
                                      VerticalAlignment="Center"/>

                            <Grid Grid.Column="1" Width="38" Height="38" l:Flow.Start="14" l:Flow.End="12" Margin="0" VerticalAlignment="Center">
                                <Border CornerRadius="10" Background="{Binding Brush}" Opacity="0.18"/>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" l:Flow.End="16" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Text="{Binding NameKey, Converter={x:Static l:LocKeyConverter.Instance}}"/>
                                    <Border CornerRadius="5" Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                            Padding="6,1.5" l:Flow.Start="8" Margin="0" VerticalAlignment="Center"
                                            Visibility="{Binding Locked, Converter={x:Static l:BoolToVisibilityConverter.Instance}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                       Foreground="{DynamicResource FgDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding [badge_admin], Source={x:Static l:Loc.I}}" FontSize="9.5"
                                                       Foreground="{DynamicResource FgDimBrush}" l:Flow.Start="5" Margin="0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource FgDimBrush}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Text="{Binding DescKey, Converter={x:Static l:LocKeyConverter.Instance}}"/>
                            </StackPanel>

                            <c:PercentBar Grid.Column="3" Height="6" VerticalAlignment="Center" l:Flow.End="16" Margin="0"
                                          Fraction="{Binding BarFraction}" BarBrush="{Binding Brush}"/>

                            <StackPanel Grid.Column="4" VerticalAlignment="Center" MinWidth="75">
                                <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource FgBrush}"
                                           Style="{DynamicResource LtrText}"
                                           Text="{Binding SizeText}" HorizontalAlignment="Right"/>
                                <TextBlock FontSize="10.5" Foreground="{DynamicResource FgDimBrush}"
                                           Text="{Binding FilesText}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Orphaned data -->
            <Grid x:Name="OrphansPanel" Visibility="Collapsed" Margin="0,62,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource Card}" Padding="14,10" Margin="0,0,0,12"
                        Background="{DynamicResource CardBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource FgDimBrush}" l:Flow.Start="10" Margin="0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="900"
                                   Text="{Binding [orphan_note], Source={x:Static l:Loc.I}}"/>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1" Style="{DynamicResource QuietList}"
                         ItemsSource="{Binding Orphans}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" Style="{DynamicResource ModernCheck}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>

                                <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" l:Flow.Start="14" l:Flow.End="12" Margin="0"
                                        Background="{DynamicResource CardHoverBrush}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource FgDimBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" l:Flow.End="12" Margin="0">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Name}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource FgDimBrush}" Margin="0,3,0,0"
                                               Style="{DynamicResource LtrText}" TextTrimming="CharacterEllipsis"
                                               Text="{Binding ShortPath}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource FgBrush}"
                                               Style="{DynamicResource LtrText}"
                                               Text="{Binding SizeText}" HorizontalAlignment="Right"/>
                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource FgDimBrush}" MaxWidth="120"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Text="{Binding [orphan_hint], Source={x:Static l:Loc.I}}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasOrphans, Converter={x:Static l:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Style="{DynamicResource SubText}" Margin="0,12,0,0"
                               Text="{Binding [orphan_empty], Source={x:Static l:Loc.I}}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Busy overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource OverlayBrush}"
                CornerRadius="0" Visibility="{Binding IsBusy, Converter={x:Static l:BoolToVisibilityConverter.Instance}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="Spinner" Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="38"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate"/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:1.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock Text="{Binding StatusText}" FontSize="14" Foreground="{DynamicResource FgBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap" MaxWidth="480"
                           TextAlignment="Center"/>
                <ProgressBar Style="{DynamicResource ModernProgress}" Width="300" Margin="0,16,0,0"
                             Maximum="100" Value="{Binding Progress, Mode=OneWay}"/>
                <Button Style="{DynamicResource GhostButton}" Content="{Binding [btn_cancel_scan], Source={x:Static l:Loc.I}}"
                        Command="{Binding CancelScanCommand}" Margin="0,18,0,0" HorizontalAlignment="Center"
                        Visibility="{Binding Phase, Converter={x:Static l:EnumToVisibilityConverter.Instance}, ConverterParameter=Scanning}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

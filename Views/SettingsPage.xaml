<UserControl x:Class="Pakban.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Pakban.Localization"
             xmlns:vm="clr-namespace:Pakban.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,22,30,26">

            <TextBlock Style="{DynamicResource TitleText}"
                       Text="{Binding [set_title], Source={x:Static l:Loc.I}}"/>
            <TextBlock Style="{DynamicResource SubText}" Margin="0,4,0,20"
                       Text="{Binding [set_sub], Source={x:Static l:Loc.I}}"/>

            <!-- Language -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CardTitleText}"
                               Text="{Binding [set_language], Source={x:Static l:Loc.I}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <RadioButton x:Name="LangEn" Style="{DynamicResource LangCard}" GroupName="lang"
                                     Width="200" Checked="OnLangEn">
                            <StackPanel>
                                <TextBlock Text="English" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FgBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Left-to-right" FontSize="10.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource FgDimBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LangFa" Style="{DynamicResource LangCard}" GroupName="lang"
                                     Width="200" l:Flow.Start="14" Margin="0" Checked="OnLangFa">
                            <StackPanel>
                                <TextBlock Text="فارسی" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FgBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="راست‌به‌چپ" FontSize="10.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource FgDimBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Theme Mode -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CardTitleText}"
                               Text="{Binding [set_theme], Source={x:Static l:Loc.I}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <RadioButton x:Name="ThemeSystem" Style="{DynamicResource LangCard}" GroupName="theme"
                                     Width="180" Checked="OnThemeSystem">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [set_theme_system], Source={x:Static l:Loc.I}}"
                                               FontSize="15" FontWeight="SemiBold" l:Flow.Start="8" Margin="0"
                                               Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding [set_theme_system_desc], Source={x:Static l:Loc.I}}"
                                           FontSize="10" Margin="0,4,0,0"
                                           Foreground="{DynamicResource FgDimBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ThemeDark" Style="{DynamicResource LangCard}" GroupName="theme"
                                     Width="180" l:Flow.Start="12" Margin="0" Checked="OnThemeDark">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [set_theme_dark], Source={x:Static l:Loc.I}}"
                                               FontSize="15" FontWeight="SemiBold" l:Flow.Start="8" Margin="0"
                                               Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding [set_theme_dark_desc], Source={x:Static l:Loc.I}}"
                                           FontSize="10" Margin="0,4,0,0"
                                           Foreground="{DynamicResource FgDimBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ThemeLight" Style="{DynamicResource LangCard}" GroupName="theme"
                                     Width="180" l:Flow.Start="12" Margin="0" Checked="OnThemeLight">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [set_theme_light], Source={x:Static l:Loc.I}}"
                                               FontSize="15" FontWeight="SemiBold" l:Flow.Start="8" Margin="0"
                                               Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding [set_theme_light_desc], Source={x:Static l:Loc.I}}"
                                           FontSize="10" Margin="0,4,0,0"
                                           Foreground="{DynamicResource FgDimBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Accent -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CardTitleText}"
                               Text="{Binding [set_accent], Source={x:Static l:Loc.I}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <ItemsControl ItemsSource="{Binding Accents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="accent" l:Flow.End="12" Margin="0" Cursor="Hand"
                                                 Click="OnAccentClick" Tag="{Binding Name}"
                                                 IsChecked="{Binding IsCurrent, Mode=OneWay}">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Grid Width="40" Height="40" Background="Transparent">
                                                    <Ellipse x:Name="Ring" Fill="{Binding Swatch}" Margin="7"
                                                             Stroke="Transparent" StrokeThickness="2"/>
                                                    <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Margin="3"
                                                             x:Name="Outer" Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Outer" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="Margin" Value="5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Confirm toggle -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{DynamicResource CardTitleText}"
                                   Text="{Binding [set_confirm], Source={x:Static l:Loc.I}}"/>
                        <TextBlock Style="{DynamicResource DimText}" Margin="0,4,0,0"
                                   Text="{Binding [set_confirm_desc], Source={x:Static l:Loc.I}}"/>
                    </StackPanel>
                    <CheckBox Style="{DynamicResource ModernSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsChecked="{Binding ConfirmBeforeClean, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <!-- About -->
            <Border Style="{DynamicResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12" ClipToBounds="True">
                            <Image Source="/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel l:Flow.Start="14" Margin="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding [app_name], Source={x:Static l:Loc.I}}"
                                           FontSize="17" FontWeight="Bold" Foreground="{DynamicResource FgBrush}"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource FgDimBrush}" l:Flow.Start="10" Margin="0"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding [about_version], Source={x:Static l:Loc.I}, Mode=OneWay}"/>
                                    <Run Text="{Binding VersionText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding [app_tagline], Source={x:Static l:Loc.I}}"
                                       FontSize="11.5" Foreground="{DynamicResource FgDimBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding [about_body], Source={x:Static l:Loc.I}}"
                               FontSize="12.5" Foreground="{DynamicResource FgDimBrush}" LineHeight="23"
                               TextWrapping="Wrap" Margin="0,16,0,0"/>
                    <TextBlock Text="{Binding [about_tech], Source={x:Static l:Loc.I}}"
                               FontSize="11" Foreground="{DynamicResource FgDimBrush}" Opacity="0.7"
                               Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

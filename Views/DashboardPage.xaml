<UserControl x:Class="Pakban.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Pakban.Localization"
             xmlns:c="clr-namespace:Pakban.Controls"
             xmlns:vm="clr-namespace:Pakban.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,22,30,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{DynamicResource TitleText}"
                               Text="{Binding [dash_title], Source={x:Static l:Loc.I}}"/>
                    <TextBlock Style="{DynamicResource SubText}" Margin="0,4,0,0"
                               Text="{Binding [dash_sub], Source={x:Static l:Loc.I}}"/>
                    <TextBlock Style="{DynamicResource DimText}" Margin="0,8,0,0"
                               Text="{Binding LastScanText}"/>
                </StackPanel>
                <Button Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        MinWidth="130"
                        Command="{Binding GoCleanCommand}"
                        Content="{Binding [btn_scan], Source={x:Static l:Loc.I}}"/>
            </Grid>

            <!-- Stat cards -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
                <Border Style="{DynamicResource Card}" l:Flow.End="14" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource DimText}"
                                   Text="{Binding [dash_total_cleanable], Source={x:Static l:Loc.I}}"/>
                        <TextBlock Style="{DynamicResource StatText}" Margin="0,10,0,0"
                                   FlowDirection="LeftToRight"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding CleanableText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" l:Flow.End="14" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource DimText}"
                                   Text="{Binding [dash_items_found], Source={x:Static l:Loc.I}}"/>
                        <TextBlock Style="{DynamicResource StatText}" Margin="0,10,0,0"
                                   Text="{Binding ItemsText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" l:Flow.End="14" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource DimText}">
                            <Run Text="{Binding [dash_ram_usage], Source={x:Static l:Loc.I}, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{DynamicResource StatText}" Margin="0,10,0,0"
                                   Text="{Binding RamText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource DimText}"
                                   Text="{Binding [dash_largest], Source={x:Static l:Loc.I}}"/>
                        <TextBlock Style="{DynamicResource StatText}" Margin="0,10,0,0" FontSize="17"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding LargestText}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Donut + drives -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="13*"/>
                    <ColumnDefinition Width="9*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource Card}" l:Flow.End="14" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{DynamicResource CardTitleText}" Margin="0,0,0,10"
                                   Text="{Binding [dash_breakdown], Source={x:Static l:Loc.I}}"/>

                        <Grid Grid.Row="1" Visibility="{Binding HasData, Converter={x:Static l:BoolToVisibilityConverter.Instance}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" MinHeight="230">
                                <c:DonutChart Segments="{Binding Segments}"/>
                                <!-- Center text lives in XAML (not OnRender) so it follows
                                     the app font and never breaks under RTL mirroring. -->
                                <StackPanel IsHitTestVisible="False"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CenterText}" FontSize="24" FontWeight="Bold"
                                               FlowDirection="LeftToRight"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource FgBrush}"/>
                                    <TextBlock Text="{Binding CenterSubText}" FontSize="11.5" Margin="0,2,0,0"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               Foreground="{DynamicResource FgDimBrush}"/>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Legend}" l:Flow.Start="12" Margin="0"
                                              VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding Brush}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12"
                                                       l:Flow.Start="9" l:Flow.End="10" Margin="0"
                                                       Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold"
                                                       Style="{DynamicResource LtrText}"
                                                       Foreground="{DynamicResource FgBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasData, Converter={x:Static l:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                       Foreground="{DynamicResource StrokeBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Style="{DynamicResource SubText}" Margin="0,12,0,0" TextAlignment="Center" MaxWidth="240"
                                       TextWrapping="Wrap"
                                       Text="{Binding [dash_no_data], Source={x:Static l:Loc.I}}"/>
                            <Button Style="{DynamicResource GhostButton}" Margin="0,16,0,0" HorizontalAlignment="Center"
                                    Command="{Binding GoCleanCommand}"
                                    Content="{Binding [dash_go_clean], Source={x:Static l:Loc.I}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{DynamicResource CardTitleText}" Margin="0,0,0,10"
                                   Text="{Binding [dash_drives], Source={x:Static l:Loc.I}}"/>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Drives}" VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,9">
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13.5"
                                                       Foreground="{DynamicResource FgBrush}"/>
                                            <TextBlock Text="{Binding FreeText}" FontSize="11.5"
                                                       Foreground="{DynamicResource FgDimBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <c:PercentBar Height="8" Margin="0,7,0,0"
                                                      Fraction="{Binding UsedFraction}"
                                                      BarBrush="{DynamicResource AccentGradientBrush}"/>
                                        <TextBlock Text="{Binding UsedText}" FontSize="11"
                                                   Foreground="{DynamicResource FgDimBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

<Window x:Class="Pakban.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:Pakban.Localization"
        xmlns:vm="clr-namespace:Pakban.ViewModels"
        xmlns:views="clr-namespace:Pakban.Views"
        mc:Ignorable="d"
        d:DesignWidth="1200" d:DesignHeight="780"
        Title="{Binding [app_name], Source={x:Static l:Loc.I}}"
        Icon="/Assets/app.ico"
        Width="1220" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="{Binding AppFont, Source={x:Static l:Loc.I}}"
        FlowDirection="{Binding IsRtl, Source={x:Static l:Loc.I}, Converter={x:Static l:BoolToFlowDirectionConverter.Instance}}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanerViewModel}">
            <views:CleanerPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RamViewModel}">
            <views:RamPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Title bar ===================== -->
        <Grid Grid.Row="0" Background="{DynamicResource Bg2Brush}">
            <StackPanel Orientation="Horizontal" l:Flow.Start="14" Margin="0" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="8" ClipToBounds="True">
                    <Image Source="/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel l:Flow.Start="10" Margin="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [app_name], Source={x:Static l:Loc.I}}"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
                    <TextBlock Text="{Binding [app_tagline], Source={x:Static l:Loc.I}}"
                               FontSize="9.5" Foreground="{DynamicResource FgDimBrush}" Margin="0,-2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Theme Toggle Button -->
                <Button Style="{DynamicResource IconButton}"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="{Binding [btn_theme], Source={x:Static l:Loc.I}}"
                        Padding="8,5" Margin="0,6" l:Flow.End="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ThemeGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource FgBrush}"/>
                </Button>

                <!-- Language Toggle Button -->
                <Button Style="{DynamicResource GhostButton}"
                        Content="{Binding OtherLanguage, Source={x:Static l:Loc.I}}"
                        Command="{Binding ToggleLanguageCommand}"
                        ToolTip="{Binding [btn_language], Source={x:Static l:Loc.I}}"
                        FontSize="11.5" FontWeight="Bold" Padding="12,5"
                        Margin="0,6" l:Flow.End="10" VerticalAlignment="Center"/>

                <Button Style="{DynamicResource WinButton}" Content="&#xE921;" Click="OnMinimize"/>
                <Button x:Name="MaxButton" Style="{DynamicResource WinButton}" Content="&#xE922;" Click="OnMaximize"/>
                <Button Style="{DynamicResource WinCloseButton}" Content="&#xE8BB;" Click="OnClose"/>
            </StackPanel>
        </Grid>

        <!-- ===================== Body ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource Bg2Brush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" Style="{DynamicResource NavList}"
                             ItemsSource="{Binding NavItems}"
                             SelectedIndex="{Binding NavIndex, Mode=TwoWay}"
                             Margin="0,10,0,0"/>

                    <StackPanel Grid.Row="1" Margin="20,0,20,16">
                        <Button Style="{DynamicResource GhostButton}"
                                Content="{Binding [btn_elevate], Source={x:Static l:Loc.I}}"
                                Command="{Binding ElevateCommand}"
                                FontSize="11.5" Padding="12,7"
                                Visibility="{Binding IsElevated, Converter={x:Static l:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}"/>
                        <Border CornerRadius="8" Background="{DynamicResource AccentSoftBrush2}"
                                Padding="12,7" Visibility="{Binding IsElevated, Converter={x:Static l:BoolToVisibilityConverter.Instance}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [badge_admin], Source={x:Static l:Loc.I}}"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" l:Flow.Start="8" Margin="0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Pakban 1.0.0" FontSize="10" Foreground="{DynamicResource FgDimBrush}"
                                   Opacity="0.6" Margin="2,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page content -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>

            <!-- ===================== Modal dialog overlay ===================== -->
            <Grid x:Name="DialogHost" Grid.Column="1" Background="{DynamicResource OverlayBrush}"
                  Visibility="Collapsed" MouseDown="OnDialogBackdropClick">
                <Border Style="{DynamicResource Card}" Width="440" MaxWidth="520"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,0,14"
                                x:Name="DialogIconBox" HorizontalAlignment="Left">
                            <TextBlock x:Name="DialogIcon" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="DialogTitle" Style="{DynamicResource CardTitleText}" FontSize="16"/>
                        <TextBlock x:Name="DialogMessage" Margin="0,10,0,20" TextWrapping="Wrap"
                                   FontSize="12.5" Foreground="{DynamicResource FgDimBrush}" LineHeight="21"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DialogCancel" Style="{DynamicResource GhostButton}"
                                    Content="{Binding [cancel], Source={x:Static l:Loc.I}}"
                                    Click="OnDialogCancel" l:Flow.End="10" Margin="0" MinWidth="96"/>
                            <Button x:Name="DialogOk" Style="{DynamicResource PrimaryButton}"
                                    Content="{Binding [ok], Source={x:Static l:Loc.I}}"
                                    Click="OnDialogOk" MinWidth="96"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
